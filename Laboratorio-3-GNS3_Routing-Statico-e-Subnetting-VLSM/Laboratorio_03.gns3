            {
                "drawing_id": "ad02ad31-bba9-4042-b11d-4a0262177fd5",
                "locked": false,
                "rotation": 0,
                "svg": "<svg width=\"946\" height=\"72\"><text font-family=\"TypeWriter\" font-size=\"10.0\" font-weight=\"bold\" fill=\"#000000\" fill-opacity=\"1.0\">1-&gt; Organizzare le reti in modo ordinato\n2-&gt; Sfruttare le default route dove possibile\n3-&gt; Configurare le route utilizzando l'indirizzo next-hop su i router filiale, filiale1, filiale-2 e Gate \n4-&gt; Configurare le route utilizzando l'interfeccia d'uscita, quella del router eterna alla lan, per i router IT, Reserch, Magazzini e Human-Resource</text></svg>",
                "x": -807,
                "y": -860,
                "z": 2
            },
            {
                "drawing_id": "0d89a79f-5fbf-4f33-b265-328e6a522f32",
                "locked": false,
                "rotation": 0,
                "svg": "<svg width=\"670\" height=\"104\"><text font-family=\"TypeWriter\" font-size=\"10.0\" font-weight=\"bold\" fill=\"#000000\" fill-opacity=\"1.0\">network router -&gt; \u00e8 la route che usa il net-id della rete di destinazione\nhost route -&gt; \u00e8 la route che usa l'indirizzo specifico dell'host -&gt; come subnet si deve usare il /32\ndefault route -&gt; state dicendo al route che i pachetti con degli indirizzi di destinzione che non sono\n                            presenti nella tabella di routing devono essere instradati ad un determinato indirizzo\n\n0.0.0.0 0.0.0.0 -&gt; indica tutta la rete </text></svg>",
                "x": -810,
                "y": -773,
                "z": 2
            },
